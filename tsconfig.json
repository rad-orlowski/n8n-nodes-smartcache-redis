{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "lib": ["es2019", "es2020.promise", "es2021.String"],
    "target": "es2019",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["nodes/**/*"],
  "exclude": ["node_modules"]
}
